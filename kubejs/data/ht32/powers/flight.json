{
    "type": "origins:multiple",
    "fly": {
        "type": "origins:creative_flight",
        "condition": {
            "type": "origins:power_active",
            "power": "ht32:flight_toggle"
        }
    },
    "toggle": {
        "type": "origins:toggle"
    },
    "exhaust": {
        "type": "origins:action_over_time",
        "interval": 2,
        "entity_action": {
            "type": "origins:exhaust",
            "amount": 0.04
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:creative_flying"
                },
                {
                    "type": "origins:power_active",
                    "power": "ht32:flight_toggle"
                }
            ]
        }
    },
    "notif": {
        "type": "origins:action_over_time",
        "interval": 1,
        "rising_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "title @s times 10t 30t 10t"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"translate\":\"ht32.power.flight.enable\"}"
                },
                {
                    "type": "origins:execute_command",
                    "command": "playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1 0.75"
                }
            ]
        },
        "falling_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "title @s times 10t 30t 10t"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"translate\":\"ht32.power.flight.disable\"}"
                },
                {
                    "type": "origins:execute_command",
                    "command": "playsound minecraft:block.note_block.bell master @s ~ ~ ~ 1 0.5"
                }
            ]
        },
        "condition": {
            "type": "origins:power_active",
            "power": "ht32:flight_toggle"
        }
    },
    "name": "ht32.power.flight",
    "description": "ht32.power.flight.desc"
}
